# Bata AI Assistant Environment Variables Template
# Copy this file to '.env' and fill in your keys

# Main Gemini API Key (Required)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Backup Gemini API Keys for Key Rotation (Optional)
VITE_GEMINI_API_KEY_2=
VITE_GEMINI_API_KEY_3=
VITE_GEMINI_API_KEY_4=
VITE_GEMINI_API_KEY_5=

# OpenWeather API Key (Required for weather-based recommendation triggers)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Store Staff Access Pin (e.g., 1234)
VITE_STAFF_PIN=1234